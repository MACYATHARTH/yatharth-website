# Environment variables for YATHARTH '26
# DATA_SOURCE can be 'demo' (deterministic demo data, no database required) or 'database' (PostgreSQL via Prisma 7)
DATA_SOURCE=demo

# PostgreSQL Connection String (used only when DATA_SOURCE=database)
# Local development dummy string - DO NOT connect to any production database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yatharth26?schema=public"
# Optional Direct/Session URL for Prisma migrations/schema pushes (e.g. Supabase port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yatharth26?schema=public"

# Admin Authentication
# Username for admin login
ADMIN_USERNAME=admin
# Password hash in format salt:hash generated with Node crypto scrypt (run script in scripts/generate-admin-hash.mjs)
ADMIN_PASSWORD_HASH=
# HMAC secret for session cookie signing (minimum 32 characters, 64-char hex string recommended)
ADMIN_SESSION_SECRET=

# Supabase Storage Configuration (for persistent file uploads: wallpapers, logos, posters, etc.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=yatharth-assets

